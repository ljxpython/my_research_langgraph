# ==================== Execution Plane (LangGraph) ====================
#
# 说明：
# - 该文件用于示例环境变量名，不包含任何真实密钥。
# - 本地运行请复制为 execution_plane/.env（该文件已被 .gitignore 忽略）。

# -------------------- LLM selection --------------------
# 可选：强制指定模型提供方：zhipu | deepseek | openai
EP_LLM_PROVIDER=zhipu

# Zhipu / GLM
ZHIPUAI_API_KEY=
ZHIPU_MODEL=GLM-4.6
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Best-effort hint for summarization middleware / providers that support profile
EP_MAX_INPUT_TOKENS=50000

# -------------------- SQL agent --------------------
# 你可以直接指定任意 SQLAlchemy DB URI（例如 sqlite 或 postgres）。
# 如果不指定，SQL Agent 会尝试使用 Chinook.db（若存在），否则自动生成一个小型 demo DB。
# SQL_AGENT_DB_URI=sqlite:////abs/path/to/Chinook.db

SQL_AGENT_TOP_K=5

# -------------------- Agent Server (prod/self-host) --------------------
# 下面这两个变量由 LangGraph Agent Server 在“持久化部署”模式下使用（dev/in-memory 不强制）。
# REDIS_URI=redis://127.0.0.1:6379/0
# DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/langgraph_db?sslmode=disable

# 执行面（Docker 持久化模式）可能需要以下任意一个（取决于 LangGraph 部署形态/版本）：
# - 预发/生产：LANGGRAPH_CLOUD_LICENSE_KEY
# - 本地 production-like 调试：LANGSMITH_API_KEY
# LANGSMITH_API_KEY=
# LANGGRAPH_CLOUD_LICENSE_KEY=
